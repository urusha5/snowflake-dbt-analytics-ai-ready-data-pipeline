# Local UI requires Node.js 24+ and no external services.
PORT=3000
APP_MODE=demo
HOST=127.0.0.1

# Production configuration belongs in deploy/web.env and deploy/worker.env.
# Do not set NODE_ENV=production with demonstration mode.

# Optional dbt configuration. Also export these into your shell for dbt.
# dbt Core 1.12 also reads .env; shell variables take precedence.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=PACIFIC_RETAIL_DB
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_SOURCE_SCHEMA=BRONZE
# Required for dbt customer_features. Keep stable; this is not a password.
# Salt appears in compiled SQL. Restrict access to artifacts.
CUSTOMER_KEY_SALT=

